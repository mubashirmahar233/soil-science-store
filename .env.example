# ============================================================
# DATABASE
# ============================================================
# PostgreSQL connection string. Configure on your host (Railway,
# Supabase, RDS, Neon, etc). Never commit the real value.
DATABASE_URL="postgresql://user:password@localhost:5432/soilscience?schema=public"

# ============================================================
# APP
# ============================================================
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================================
# AUTH (NextAuth)
# ============================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ============================================================
# PAYMENT PROVIDER (Stripe by default — see lib/payments/README.md
# to swap providers via the PaymentProvider interface)
# ============================================================
PAYMENT_PUBLIC_KEY=""      # Stripe publishable key (pk_...)
PAYMENT_SECRET_KEY=""      # Stripe secret key (sk_...) — server only, never expose
PAYMENT_WEBHOOK_SECRET=""  # Stripe webhook signing secret (whsec_...)

# ============================================================
# EMAIL (transactional email provider — Resend by default)
# ============================================================
EMAIL_API_KEY=""
EMAIL_FROM="Soil Science for Students <orders@yourdomain.com>"

# ============================================================
# PRIVATE OBJECT STORAGE (S3-compatible: AWS S3, Cloudflare R2,
# Backblaze B2, etc.) — used for paid PDF files, never public.
# ============================================================
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""        # required for R2/B2, omit for AWS S3

# ============================================================
# ADMIN BOOTSTRAP (used once by prisma/seed.ts to create the
# first ADMIN account — rotate/remove after first login)
# ============================================================
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
